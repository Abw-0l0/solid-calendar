{
  "name": "solidcalendar-pro",
  "version": "0.3.0",
  "description": "Optional plugins for solidcalendar — drag persistence and Japanese holidays",
  "type": "module",
  "main": "./dist/calendar-pro.cjs",
  "module": "./dist/calendar-pro.esm.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/calendar-pro.esm.js",
      "require": "./dist/calendar-pro.cjs",
      "default": "./dist/calendar-pro.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "solidcalendar": "^0.3.0"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^4.1.10",
    "jsdom": "^30.0.1",
    "eslint": "^10.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Abdul Basit Iqbal",
  "license": "MIT",
  "keywords": [
    "solidcalendar",
    "calendar",
    "scheduler",
    "drag-drop",
    "holidays",
    "japan"
  ],
  "browser": "./dist/calendar-pro.global.min.js",
  "unpkg": "./dist/calendar-pro.global.min.js",
  "sideEffects": false,
  "homepage": "https://github.com/Abw-0l0/solid-calendar/tree/main/packages/pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abw-0l0/solid-calendar.git",
    "directory": "packages/pro"
  },
  "bugs": {
    "url": "https://github.com/Abw-0l0/solid-calendar/issues"
  },
  "jsdelivr": "./dist/calendar-pro.global.min.js"
}
